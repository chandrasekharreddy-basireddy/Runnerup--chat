# ---- placeholders only. never commit a filled-in .env ----
ENVIRONMENT=development
LOG_LEVEL=INFO

# 32+ random bytes, base64. openssl rand -base64 48
JWT_SIGNING_KEY=replace-me
OTP_PEPPER=replace-me
COOKIE_SIGNING_KEY=replace-me

ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=2592000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=chat
POSTGRES_USER=chat_app
POSTGRES_PASSWORD=replace-me
POSTGRES_SUPERUSER_PASSWORD=replace-me
POSTGRES_SSLMODE=prefer

REDIS_URL=redis://:replace-me@redis:6379/0
REDIS_PASSWORD=replace-me

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://localhost/files
S3_REGION=us-east-1
S3_BUCKET=chat-media
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me

SMS_PROVIDER=console
SMS_API_KEY=replace-me
SMS_SENDER_ID=replace-me

ALLOWED_ORIGINS=https://localhost
PUBLIC_WEB_ORIGIN=https://localhost
MAX_UPLOAD_BYTES=52428800
